# Never commit real secrets. Copy to .env on the Asterisk host.
ASTERISK_PUBLIC_IP=203.0.113.10
ASTERISK_PUBLIC_HOST=pbx.example.com
ASTERISK_LOCAL_NET=10.0.0.0/8

# Twilio account API credentials - use only on the server/bootstrap machine.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me

# Unique Twilio trunk domain. It must end with pstn.twilio.com.
TWILIO_TRUNK_NAME=reborn-ai
TWILIO_TRUNK_DOMAIN=reborn-ai.pstn.twilio.com
TWILIO_CALLER_ID_E164=+351XXXXXXXXX

# Digest auth Asterisk -> Twilio termination
TWILIO_SIP_USERNAME=reborntrunk
TWILIO_SIP_PASSWORD=replace_with_long_random_password

# Twilio origination -> Asterisk identify networks.
# Use the CURRENT signalling CIDRs for the Twilio edge/region you choose.
TWILIO_SIGNALING_CIDR_1=REPLACE_WITH_CURRENT_TWILIO_CIDR
TWILIO_SIGNALING_CIDR_2=REPLACE_WITH_CURRENT_TWILIO_CIDR

REBORN_SIP_PASSWORD=replace_with_long_random_password
ARI_PASSWORD=replace_with_long_random_password
