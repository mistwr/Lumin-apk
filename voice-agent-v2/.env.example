# REBORN Voice Agent V2
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=reborn
ASTERISK_ARI_PASSWORD=replace_me
ASTERISK_STASIS_APP=reborn-voice-v2

# Upstream reference
VOICEBRIDGE_REPO=https://github.com/asterisk/AsteriskVoiceBridge.git
VOICEBRIDGE_REF=master
VOICEBRIDGE_DIR=/opt/reborn/AsteriskVoiceBridge

# Providers used by upstream demo. Keep blank if replacing with local providers.
OPENAI_API_TOKEN=
DG_API_TOKEN=

# Future local stack
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:1.7b
STT_MODE=provider
TTS_MODE=provider
