# REBORN Voice Agent V2
# Copy to .env on the Linux server. Never commit real secrets.

# Asterisk / ARI
ASTERISK_PUBLIC_IP=203.0.113.10
ASTERISK_LOCAL_NET=10.0.0.0/8
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=reborn
ASTERISK_ARI_PASSWORD=replace_with_long_random_password
ASTERISK_STASIS_APP=voicebot
ARI_PASSWORD=replace_with_same_ari_password
REBORN_SIP_PASSWORD=replace_with_long_random_password

# Twilio Elastic SIP Trunk
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_TRUNK_NAME=reborn-ai
TWILIO_TRUNK_DOMAIN=reborn-ai.pstn.twilio.com
TWILIO_CALLER_ID_E164=+351XXXXXXXXX
TWILIO_SIP_USERNAME=reborntrunk
TWILIO_SIP_PASSWORD=replace_with_long_random_password
TWILIO_SIGNALING_CIDR_1=54.172.60.0/30
TWILIO_SIGNALING_CIDR_2=54.244.51.0/30

# AsteriskVoiceBridge upstream
VOICEBRIDGE_REPO=https://github.com/asterisk/AsteriskVoiceBridge.git
VOICEBRIDGE_REF=master
VOICEBRIDGE_DIR=/opt/reborn/AsteriskVoiceBridge
REBORN_BRAIN_URL=http://127.0.0.1:8080

# Deepgram is still used for realtime STT/TTS in this first working path.
DG_API_TOKEN=

# Local brain
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_URL=http://127.0.0.1:11434
SOFIA_SYSTEM_PROMPT=És a Sofia, assistente virtual da MY POUPar+. Fala em português de Portugal, de forma curta, natural e profissional. Faz no máximo uma pergunta por turno. Nunca inventes preços, campanhas, cobertura ou dados do cliente.
